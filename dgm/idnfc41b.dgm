VERSION 1.1.0
INPUT
TITLE:
 identity nfc multigroup model

DATA:
    FILE IS idnfc.dat;
    FORMAT IS FREE;
    LISTWISE=ON;
VARIABLE:
    NAMES ARE
       idscal pidscal issue1sc issue2sc issue3sc issue4sc issue5sc issue6sc
       issue7sc issue8sc rsex age01 income01 reduc01 rblack rlat rsd2 rsdic
       nfp1 nfp2 nfp3;
    USEVARIABLES ARE
       idscal pidscal issue1sc issue2sc issue3sc issue4sc issue5sc issue6sc
       issue7sc issue8sc rsex age01 income01 reduc01 rblack rlat
       nfp1 nfp2 nfp3;
    GROUPING IS rsdic (0 = low 1 = high);
    MISSING ARE ALL (-9999);
ANALYSIS:
    TYPE = GENERAL;
    ESTIMATOR = ML;
    ITERATIONS = 50000;
    BOOTSTRAP = 1000;
    CONVERGENCE = 0.00005;
OUTPUT:
 STANDARDIZED CINTERVAL(BCBOOTSTRAP);
MODEL:
    NFC BY nfp1@1 nfp2* nfp3*;
    ISSC BY issue1sc@1 issue2sc* issue3sc* issue4sc* issue5sc* issue6sc*
        issue7sc* issue8sc*;
    idscal ON age01 rsex rblack rlat reduc01 income01;
    idscal ON NFC (a1);
    pidscal ON age01 rsex rblack rlat reduc01 income01;
    pidscal ON NFC (a2);
    ISSC ON age01 rsex rblack rlat reduc01 income01;
    ISSC ON idscal (b1);
    ISSC ON pidscal (b2);
    ISSC ON NFC;
    [nfp1 nfp2 nfp3];
    [issue1sc issue2sc issue3sc issue4sc issue5sc issue6sc issue7sc issue8sc];
    [NFC@0];
    [ISSC@0];
    NFC;
    ISSC;
    idscal WITH pidscal;
    ISSUE4SC WITH ISSUE3SC;
MODEL HIGH:
    NFC BY nfp1@1 nfp2* nfp3*;
    ISSC BY issue1sc@1 issue2sc* issue3sc* issue4sc* issue5sc* issue6sc*
        issue7sc* issue8sc*;
    idscal ON age01 rsex rblack rlat reduc01 income01;
    idscal ON NFC (a1h);
    pidscal ON age01 rsex rblack rlat reduc01 income01;
    pidscal ON NFC (a2h);
    ISSC ON age01 rsex rblack rlat reduc01 income01 NFC;
    ISSC ON idscal (b1h);
    ISSC ON pidscal (b2h);
    ISSC ON NFC;
    [nfp1 nfp2 nfp3];
    [issue1sc issue2sc issue3sc issue4sc issue5sc issue6sc issue7sc issue8sc];
    [NFC@0];
    [ISSC@0];
    NFC;
    ISSC;
    idscal WITH pidscal;
    ISSUE4SC WITH ISSUE3SC;
INPUT_END
