TITLE: mplusplus synthetic fixture: one factor with binary items
  (invented model and names; simulated data only)
DATA: FILE IS syn_cat.dat;
VARIABLE:
  NAMES ARE u1 u2 u3 u4;
  USEVARIABLES ARE u1 u2 u3 u4;
  CATEGORICAL ARE u1 u2 u3 u4;
DEFINE:
  CUT u1 u2 u3 u4 (0);
MODEL:
  fu BY u1* u2 u3 u4;
  fu@1;
OUTPUT: STANDARDIZED;
