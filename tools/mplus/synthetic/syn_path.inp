TITLE: mplusplus synthetic fixture: path analysis with no latent variables
  (invented model and names; simulated data only)
DATA: FILE IS syn_path.dat;
VARIABLE:
  NAMES ARE m1 d1 d2 k1 k2 k3;
  USEVARIABLES ARE m1 d1 d2 k1 k2 k3;
MODEL:
  m1 ON k1 k2;
  d1 ON m1 k3;
  d2 ON m1 k1;
  d1 WITH d2;
OUTPUT: STANDARDIZED;
