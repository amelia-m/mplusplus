TITLE: mplusplus synthetic fixture: one factor and a regression in two groups
  (invented model and names; simulated data only)
DATA: FILE IS syn_twogroup.dat;
VARIABLE:
  NAMES ARE m1 m2 m3 n1 g;
  USEVARIABLES ARE m1 m2 m3 n1;
  GROUPING IS g (1 = ga 2 = gb);
MODEL:
  fm BY m1* m2 m3;
  fm@1;
  n1 ON fm;
MODEL gb:
  n1 ON fm;
OUTPUT: STANDARDIZED;
